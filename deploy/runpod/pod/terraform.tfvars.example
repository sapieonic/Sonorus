# Copy to terraform.tfvars and edit.
image = "docker.io/you/sonorus:0.2.0"

# Must be in stock in the volume's data center (see step 3 of runpod-deployment-guide.md).
# gpu_type_id       = "NVIDIA L40S"   # or "NVIDIA A40", "NVIDIA RTX A6000", "NVIDIA H100 80GB HBM3" (H100 SXM)
# fish_enabled      = true
# fish_compile      = false
# container_disk_gb = 30

# Only for a private image (Docker Hub access token, or a GHCR token with read:packages):
# registry_username = "you"
# registry_password = "..."
